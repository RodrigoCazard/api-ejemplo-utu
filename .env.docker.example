# Copia este archivo como .env en la raiz del proyecto:
#
#   Copy-Item .env.docker.example .env     (PowerShell)
#   cp .env.docker.example .env            (Linux/macOS)
#
# Genera SECRET_KEY con el comando PowerShell documentado en el README.

SECRET_KEY=

# development habilita configuracion local para aprender y depurar.
# En un servidor publico cambialo a production.
APP_ENV=development

TOKEN_LIFETIME=3600

# Origen del frontend autorizado para enviar cookies en api-completa.
FRONTEND_ORIGIN=http://localhost:5173

# Credenciales de la base que existe unicamente dentro de Docker.
DB_PASSWORD=utu_password
MYSQL_ROOT_PASSWORD=root_password

# Puertos publicados en la computadora.
API_SIMPLE_PORT=8001
API_COMPLETA_PORT=8002
MYSQL_PORT=3307

